# 复制为 .env 后填写（.env 已被 .gitignore，不会提交）。
# 配置说明见：md文档/环境与密钥配置.md

# ========== 本地开发（profile=dev）==========
SPRING_PROFILES_ACTIVE=dev
PORT=8080
# 头像等公开链接前缀，须与 PORT 一致（见 UserAvatarService）
APP_PUBLIC_BASE_URL=http://localhost:8080

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=ai_gp

# JWT：至少 32 个字符的随机串（可用 PowerShell: 见 md文档/环境与密钥配置.md）
JWT_SECRET_KEY=replace-with-random-string-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# 仅本地联调：注册/找回密码发码接口返回 debugCode
APP_AUTH_VERIFICATION_DEBUG_RETURN_CODE=true

# AI 对话中间过程写入 txt（见 pipeline-debug-log-file）；生产务必 false
AI_CHAT_PIPELINE_DEBUG_LOG=true
AI_CHAT_PIPELINE_DEBUG_LOG_FILE=logs/ai-chat-pipeline.txt
# 闲聊/短句跳过 plan LLM；任务相关仍走完整多阶段
AI_CHAT_FAST_PATH_ENABLED=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

LLM_API_KEY=
MIMO_API_KEY=

# 语音转写：须先按 md文档/本地语音转写-STT部署.md 启动 Docker STT（127.0.0.1:9000）
APP_SPEECH_ENABLED=true
APP_SPEECH_BASE_URL=http://127.0.0.1:9000

# 移动系统推送 uni-push 2.0（锁屏/杀进程）；见 md文档/环境与密钥配置.md §3.5
APP_MOBILE_PUSH_ENABLED=false
APP_MOBILE_PUSH_PROVIDER=unipush
APP_UNIPUSH_CLOUD_URL=
APP_UNIPUSH_HTTP_SECRET=
# 仅 provider=fcm 时填写 Firebase 服务账号 JSON 路径
FCM_CREDENTIALS_PATH=
# APP_MOBILE_PUSH_CHAT_REPLY=false

# ========== 生产环境（profile=prod）==========
# 生产不要在仓库放 .env，应在服务器/容器/密钥管理中设置下列变量（无默认值）：
#   SPRING_PROFILES_ACTIVE=prod
#   JWT_SECRET_KEY=<运维生成的长随机串，与本地不同>
#   MYSQL_PASSWORD=...
#   APP_AUTH_VERIFICATION_DEBUG_RETURN_CODE=false
#   MIMO_API_KEY=...
# 详见 md文档/环境与密钥配置.md
